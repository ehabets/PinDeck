  "repository": {
    "type": "git",
    "url": "git+https://github.com/ehabets/PinDeck.git"
  },
  "homepage": "https://github.com/ehabets/PinDeck#readme",
  "bugs": "https://github.com/ehabets/PinDeck/issues",
  "type": "module",
  "bin": {
